{
  "name": "brandy",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "brandy": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/server.ts",
    "./adapters": "./src/adapters.ts",
    "./build": "./src/build-api.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts dev",
    "build": "bun src/cli.ts build",
    "start": "bun src/cli.ts start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:client": "bun build src/client/runtime-alpine.ts --target=browser --minify --outfile=dist/brandy.js"
  },
  "dependencies": {
    "@elysiajs/html": "1.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/cli": "^4.3.2",
    "alpinejs": "^3.15.12",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3"
  }
}
